<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.andre</groupId>
    <artifactId>rinha-fraud</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <!--
      Learning notes:
      - No Spring. No Helidon. No Jackson. Nothing.
      - The HTTP server comes from the JDK itself (com.sun.net.httpserver).
      - The JSON parser is hand-rolled, written for this challenge's fixed schema.
      - jdk.incubator.vector is enabled for step 2 (SIMD via Vector API).
    -->

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <main.class>com.andre.rinha.App</main.class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- Vector API is still incubator; needs the flag to compile. -->
                    <compilerArgs>
                        <arg>--add-modules=jdk.incubator.vector</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <argLine>--add-modules=jdk.incubator.vector</argLine>
                </configuration>
            </plugin>
            <!-- Packages a single executable JAR (light uberjar, no runtime deps). -->
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>${main.class}</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          v6: GraalVM native-image profile.
          Activate with: mvn -Pnative -DskipTests package
          Output: target/rinha-fraud (a static binary).

          Flags below (XML comments cannot contain consecutive dashes, so the
          long form "no-fallback" stands in for the literal command-line flag):

          no-fallback        hard-fail if native-image cannot compile, instead
                             of producing a JVM-bundled fallback.
          add-modules=jdk.incubator.vector
                             same module flag the JIT build needs at compile time.
          UnlockExperimentalVMOptions + VectorAPISupport
                             experimental but functional in GraalVM 25; enables
                             native code generation for jdk.incubator.vector
                             ops. Without it, Vector API falls back to scalar.
          O3                 maximum optimization (longer build, faster binary).
          gc=serial          smallest and most predictable GC for our workload
                             (single-threaded handlers, small heap).
        -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.10.3</version>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>rinha-fraud</imageName>
                            <mainClass>${main.class}</mainClass>
                            <buildArgs>
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>--add-modules=jdk.incubator.vector</buildArg>
                                <buildArg>-O3</buildArg>
                                <buildArg>--gc=serial</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
